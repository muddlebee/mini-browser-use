# Copy this file to .env and fill it in. .env is ignored by git.

# Which model drives the browser: <provider>:<model-id>
# Providers: anthropic, openai, google, custom (any OpenAI-compatible server, see below)
MODEL=anthropic:claude-opus-5-5

# API key for the provider you picked (only that one is needed)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# For MODEL=custom:<model-id> -- OpenRouter, Ollama, LM Studio, Groq, ...
# CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_API_KEY=

# Optional
# BROWSER=chrome
# HEADED=1
# SCREENSHOTS=0
